{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@carasta/types": [
        "../../packages/types/src/index.ts"
      ],
      "@carasta/mock-data": [
        "../../packages/mock-data/src/index.ts"
      ],
      "@carasta/mock-data/services": [
        "../../packages/mock-data/src/services/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
